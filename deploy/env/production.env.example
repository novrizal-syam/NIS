# Production (Jakarta-region VM or managed Postgres). Secrets come from the server's secret store
# or an .env file readable only by the deploy user (chmod 600); never commit real values.
APP_ENV=production
APP_NAME=Nustrad ERP
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta
SECRET_KEY=<64 random characters>
DATA_ENCRYPTION_KEYS=<Fernet key - keep a sealed copy offline>
APP_BASE_URL=https://erp.example.co.id
CORS_ORIGINS=https://erp.example.co.id
DATABASE_URL=postgresql+asyncpg://nustrad:<password>@<db-host>:5432/nustrad
DB_POOL_SIZE=10
S3_ENDPOINT_URL=<object storage endpoint>
S3_ACCESS_KEY=<key>
S3_SECRET_KEY=<secret>
S3_BUCKET=nustrad-erp
S3_REGION=ap-southeast-3
EMAIL_PROVIDER=smtp
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_USER=<user>
SMTP_PASSWORD=<password>
SMTP_TLS=true
EMAIL_FROM=no-reply@example.co.id
SCHEDULER_ENABLED=true
SETUP_TOKEN=<one-time token for the first-run wizard; remove after setup>
PJAP_BASE_URL=
PJAP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Backups (deploy/backup): PG* variables for pg_dump, BACKUP_DIR on a separate disk,
# MC_TARGET for the off-site copy.
