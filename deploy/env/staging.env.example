# Staging: same security rules as production (HTTPS, real secrets, encryption key); own
# database, own bucket, own email sender. Restore a recent production backup here to rehearse
# go-live and upgrades; never point staging at production data stores.
APP_ENV=staging
APP_NAME=Nustrad ERP (staging)
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta
SECRET_KEY=<64 random characters>
DATA_ENCRYPTION_KEYS=<Fernet key for staging - different from production>
APP_BASE_URL=https://erp-staging.example.co.id
CORS_ORIGINS=https://erp-staging.example.co.id
DATABASE_URL=postgresql+asyncpg://nustrad:<password>@db:5432/nustrad_staging
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=nustrad-staging
S3_SECRET_KEY=<random>
S3_BUCKET=nustrad-erp-staging
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply-staging@example.co.id
SCHEDULER_ENABLED=true
# Integrations stay in manual/file mode on staging unless testing a provider sandbox.
PJAP_BASE_URL=
WHATSAPP_TOKEN=
