# Copy to .env and adjust. Never commit .env.

# --- App ---
APP_ENV=development
APP_NAME=Nustrad ERP
LOG_LEVEL=INFO
TIMEZONE=Asia/Jakarta
# Random string, 32+ chars; signs JWTs and encrypts 2FA secrets.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production-0000
# Comma-separated origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=nustrad
POSTGRES_PASSWORD=nustrad
POSTGRES_DB=nustrad
DATABASE_URL=postgresql+asyncpg://nustrad:nustrad@db:5432/nustrad
# Used by pytest; the database must exist (created by docker/db-init).
TEST_DATABASE_URL=postgresql+asyncpg://nustrad:nustrad@db:5432/nustrad_test

# --- Object storage (MinIO in dev, any S3-compatible in prod) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=nustrad
S3_SECRET_KEY=nustrad-secret
S3_BUCKET=nustrad-erp
S3_REGION=us-east-1
MINIO_ROOT_USER=nustrad
MINIO_ROOT_PASSWORD=nustrad-secret

# --- Email ---
# EMAIL_PROVIDER: smtp | resend. Leave empty when email is not set up: nothing fails,
# admins see activation links to copy, and email_log records not_configured.
EMAIL_PROVIDER=smtp
# SMTP (dev: Mailpit, UI at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS on the SMTP port; port 465 always uses implicit TLS.
SMTP_TLS=false
# Resend (https://resend.com) when EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@nustrad.local
EMAIL_FROM_NAME=Nustrad ERP
# Base URL used for links in emails (activation, password reset).
APP_BASE_URL=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
# Where the Vite dev server proxies /api (inside compose this is the api service).
VITE_API_PROXY_TARGET=http://api:8000

# --- First-run setup ---
# One-time token the first Super Admin types at /setup. Generate a random value;
# it is useless once setup is finished.
SETUP_TOKEN=

# --- Demo data (make demo) ---
DEMO_PASSWORD=Demo-GEK-2026

# --- Auth ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=30
TOTP_ISSUER=Nustrad ERP

# --- Background jobs ---
# Run DOA escalation inside the API process (or schedule `python -m app.workflow.jobs escalate`).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=900
# How often the email outbox is delivered.
EMAIL_INTERVAL_SECONDS=30
